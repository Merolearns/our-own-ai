# Caddy route for the agent platform — APPEND to the VPS Caddyfile BELOW
# SLATE's blocks. Keep it separate from SLATE's routes: a bad edit here must
# never take SLATE down, and a SLATE edit must never take this app down.
#
# Host: agents.40.160.149.104.nip.io (free nip.io DNS, same as SLATE's
# 40.160.149.104.nip.io host). Caddy auto-provisions the Let's Encrypt cert;
# no domain purchase needed.
#
# LIVE Nov 8, 2026 (run 6 + SLATE chat): Caddy runs as Docker container
# `slate-caddy`, NOT a host service — there is no /etc/caddy/Caddyfile on
# the host and no systemctl caddy. The Caddyfile lives at
# /srv/slate/infra/caddy/Caddyfile on the host (bind-mounted read-only
# into the container). Edit the HOST file, then:
#   docker exec slate-caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec slate-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
# Only reload after validation exits 0. A bad Caddyfile breaks every site
# on the box, SLATE included.
#
# `reverse_proxy localhost:8001` does NOT work from inside the Caddy
# container (localhost = the container itself). The Caddy container was
# connected to the agent-platform_default network
# (docker network connect agent-platform_default slate-caddy) and the
# route points at the container by name on its INTERNAL port 8000
# (the 8001 mapping is host-side only).

agents.40.160.149.104.nip.io {
	reverse_proxy agent-platform:8000
}

# Agent 2 — Scoopy Doog (Nov 8, 2026). SAME container, SAME port: the
# single process serves both agents and picks the agent from the request
# Host header (agents.* -> parcelco, scoopy.* -> scoopy, anything else ->
# parcelco). No second container exists — the 8 GB box cannot hold two
# app processes at peak (see BUILD_BRIEF_SCOOPY.md). The Caddy container
# is already on the agent-platform_default network from the Parcelco
# route, so this block needs no new network connect — append, validate,
# reload, same as before. The Parcelco container keeps serving through
# the whole change: a bad Caddyfile breaks every site on the box, SLATE
# included, so never reload a failed validation.

scoopy.40.160.149.104.nip.io {
	reverse_proxy agent-platform:8000
}
